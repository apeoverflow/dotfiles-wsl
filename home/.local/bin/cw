#!/usr/bin/env bash
# ~/.local/bin/cw — Launcher for GitHub Copilot CLI (the only agent on WSL).
# Creates a tmux window (optionally a git worktree), registers it in pane-map.
# The session id is passed to copilot (--session-id) so its agentStop /
# notification hooks can find this window via ~/.claude/pane-map/<id>.json.
#
# Usage: cw <name> [-w] [-d|-s|-sd|-n] [--agent <agent>] [-- <extra-args...>]
#
# Worktree:
#   (default)   run in the current directory
#   -w          create/reuse a git worktree at .agents/worktrees/<name>
#   -nw         no-op (kept so old invocations don't error)
#
# Mode:
#   (default)   Opus   + --allow-all-tools
#   -d          Opus   + --allow-all (tools, paths and URLs)
#   -s          Sonnet + normal mode (prompts enabled)
#   -sd         Sonnet + --allow-all
#   -n          normal mode (prompts enabled)
#   -c / -cp    no-op (copilot is already the only tool; kept for muscle memory)
set -euo pipefail

export PATH="$HOME/.local/bin:$PATH"

usage() {
  printf 'usage: cw <name> [-w] [-d|-s|-sd|-n] [--agent <agent>] [-- <extra-args...>]\n' >&2
  exit 1
}

[[ $# -eq 0 ]] && usage
name="$1"; shift

tool="copilot"
agent=""
model=""
permission_mode="auto"
use_worktree=false
extra_args=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    -cp|-c)    shift ;;
    -d)        permission_mode="bypass"; shift ;;
    -s)        model="sonnet"; permission_mode=""; shift ;;
    -sd)       model="sonnet"; permission_mode="bypass"; shift ;;
    -n)        permission_mode=""; shift ;;
    -w)        use_worktree=true; shift ;;
    -nw)       use_worktree=false; shift ;;
    --agent)   agent="${2:?--agent requires a value}"; shift 2 ;;
    -h|--help) usage ;;
    --)        shift; extra_args+=("$@"); break ;;
    *)         extra_args+=("$1"); shift ;;
  esac
done

# Copilot model ids — availability is per account/plan (check with /model in copilot)
[[ "$model" == "sonnet" ]] && model="claude-sonnet-5.5" || model="claude-opus-5.5"

printf 'cw: launching %s (%s)\n' "$tool" "$model"

# Pre-flight checks
[[ -n "${TMUX:-}" ]] || {
  printf 'cw: must be run inside a tmux session\n' >&2; exit 1
}
command -v "$tool" >/dev/null 2>&1 || {
  printf 'cw: %s not found on $PATH\n' "$tool" >&2; exit 1
}
command -v jq >/dev/null 2>&1 || {
  printf 'cw: jq not found — sudo apt install jq\n' >&2; exit 1
}
if ! git rev-parse --git-dir >/dev/null 2>&1; then
  printf 'cw: not a git repo — initialising\n'
  git init >/dev/null 2>&1
fi
if ! git rev-parse HEAD >/dev/null 2>&1; then
  printf 'cw: no commits — creating initial commit\n'
  git commit --allow-empty -m "initial commit" >/dev/null 2>&1
fi

session_id=$(uuidgen | tr '[:upper:]' '[:lower:]')
mkdir -p ~/.claude/pane-map

repo_root=$(git rev-parse --show-toplevel)
worktree_dir="${repo_root}/.agents/worktrees/${name}"
legacy_worktree_dir="${repo_root}/.claude/worktrees/${name}"

# Clean stale worktree entries (e.g. directory deleted without `git worktree remove`)
git worktree prune 2>/dev/null || true

if [[ "$use_worktree" != true ]]; then
  window_name="$name"
  launch_dir="$(pwd)"
elif [[ -d "$worktree_dir" ]]; then
  window_name="${name}+"
  launch_dir="$worktree_dir"
elif [[ -d "$legacy_worktree_dir" ]]; then
  # Pre-rename checkouts still live under .claude/worktrees
  window_name="${name}+"
  launch_dir="$legacy_worktree_dir"
else
  # Create worktree — reuse existing branch or create a new one from current branch
  mkdir -p "$(dirname "$worktree_dir")"
  if git show-ref --verify --quiet "refs/heads/$name" 2>/dev/null; then
    git worktree add "$worktree_dir" "$name" 2>/dev/null || {
      printf 'cw: failed to create worktree\n' >&2; exit 1
    }
  else
    current_branch=$(git branch --show-current)
    git worktree add -b "$name" "$worktree_dir" "${current_branch:-HEAD}" 2>/dev/null || {
      printf 'cw: failed to create worktree\n' >&2; exit 1
    }
  fi
  window_name="$name"
  launch_dir="$worktree_dir"
fi

# Build copilot args
tool_args=("--session-id" "$session_id" "--name" "$window_name" "--model" "$model")
if [[ "$permission_mode" == "bypass" ]]; then
  tool_args+=("--allow-all")
elif [[ -n "$permission_mode" ]]; then
  tool_args+=("--allow-all-tools")
fi
[[ -n "$agent" ]] && tool_args+=("--agent" "$agent")

[[ ${#extra_args[@]} -gt 0 ]] && tool_args+=("${extra_args[@]}")

bootstrap=$(mktemp /tmp/cw-XXXXXX.sh)
quoted_args=$(printf '%q ' "${tool_args[@]}")
quoted_dir=$(printf '%q' "$launch_dir")
osc2_id="${tool}:${session_id}"

cat > "$bootstrap" << BOOTSTRAP
#!/usr/bin/env bash
rm -f $(printf '%q' "$bootstrap")
cd ${quoted_dir}
printf '\033]2;${osc2_id}\033\\'
printf '%s\n' "exec ${tool} ${quoted_args}" > /tmp/cw-debug.log
exec ${tool} ${quoted_args}
BOOTSTRAP
chmod +x "$bootstrap"

pane_target=$(tmux new-window -P -F '#{session_name}:#{window_index}.#{pane_index}' \
  -n "$window_name" "$bootstrap")

# Resolve base branch — skip test/ prefixes to find the real base.
# If on test/foo, look up foo's pane-map for the original base_branch.
# If on a normal branch, use it directly.
base_branch=$(git branch --show-current 2>/dev/null || echo "main")
if [[ "$base_branch" == test/* ]]; then
  inner="${base_branch#test/}"
  resolved=""
  for mapfile in ~/.claude/pane-map/*.json; do
    [[ -f "$mapfile" ]] || continue
    wt=$(jq -r '.worktree // empty' "$mapfile" 2>/dev/null) || continue
    if [[ "$wt" == "$inner" || "$wt" == "${inner}+" ]]; then
      resolved=$(jq -r '.base_branch // empty' "$mapfile" 2>/dev/null) || true
      [[ -n "$resolved" ]] && break
    fi
  done
  if [[ -n "$resolved" && "$resolved" != test/* ]]; then
    base_branch="$resolved"
  else
    base_branch="main"
  fi
fi
jq -n \
  --arg sid  "$session_id" \
  --arg pt   "$pane_target" \
  --arg wt   "$window_name" \
  --arg cwd  "$launch_dir" \
  --arg tool "$tool" \
  --arg base "$base_branch" \
  '{"session_id":$sid,"pane_target":$pt,"worktree":$wt,"cwd":$cwd,"tool":$tool,"base_branch":$base}' \
  > ~/.claude/pane-map/"$session_id".json

printf 'cw: %s → %s (%s, session %s)\n' "$window_name" "$pane_target" "$tool" "$session_id"
