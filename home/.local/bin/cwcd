#!/usr/bin/env bash
# ~/.local/bin/cwcd — checkout a test branch created by Prefix+b.
# Usage: cwcd [name]  (fzf picker if no name given)
set -euo pipefail

git rev-parse --git-dir >/dev/null 2>&1 || {
  echo "not in a git repo" >&2; exit 1
}

branches=$(git branch --list 'test/*' --format='%(refname:short)' 2>/dev/null)
[[ -z "$branches" ]] && { echo "no test branches — press Prefix+b in a worktree first" >&2; exit 1; }

if [[ $# -gt 0 ]]; then
  target="test/$1"
  git show-ref --verify --quiet "refs/heads/$target" || { echo "branch '$target' not found" >&2; exit 1; }
else
  target=$(printf '%s\n' "$branches" | fzf --prompt="checkout branch > " --height=40% --reverse) || exit 0
fi

echo "$target"
