#!/usr/bin/env bash
# ~/.local/bin/claude-pr — push the current worktree branch and open a PR.
# Called by: bind p display-popup -E -h 50% -w 70% "~/.local/bin/claude-pr"
set -euo pipefail

pane_dir=$(tmux display-message -p '#{pane_current_path}')
cd "$pane_dir"

git rev-parse --git-dir >/dev/null 2>&1 || {
  echo "Not a git repo"; sleep 2; exit 1
}

branch=$(git branch --show-current)
[[ -z "$branch" ]] && { echo "No branch checked out"; sleep 2; exit 1; }

# Check for uncommitted changes
has_changes=false
if ! git diff --quiet || ! git diff --cached --quiet || [[ -n "$(git ls-files --others --exclude-standard 2>/dev/null | head -1)" ]]; then
  has_changes=true
fi

if [[ "$has_changes" == true ]]; then
  echo "Uncommitted changes detected on '$branch':"
  echo ""
  git --no-pager diff --stat
  git --no-pager diff --cached --stat
  git ls-files --others --exclude-standard 2>/dev/null | head -10 | sed 's/^/  ?? /'
  echo ""
  echo "  1) Commit changes first, then create PR"
  echo "  2) Create PR without uncommitted changes"
  echo "  3) Cancel"
  echo ""
  printf "Choice [1/2/3]: "
  read -r choice

  case "$choice" in
    1)
      git add -A
      diff=$(git --no-pager diff --cached --stat && echo "---" && git --no-pager diff --cached -- . ':(exclude)*.lock' ':(exclude)package-lock.json' | head -300)
      echo "Generating commit message (this may take a few seconds)..."
      msg=$(printf '%s' "$diff" | claude -p \
        "Write a git commit message for these changes on branch '${branch}'.
Use conventional commit format. First line under 72 chars. Add a blank line then 1-3 bullet points if needed.
Output ONLY the commit message, nothing else." \
        --model claude-sonnet-4-6 2>/dev/null) || msg=""
      [[ -z "$msg" ]] && msg="wip: ${branch} — remaining changes"
      echo "Committing..."
      git commit -m "$msg" || { echo "Commit failed"; sleep 2; exit 1; }
      echo "Committed: $(echo "$msg" | head -1)"
      echo ""
      ;;
    2)
      echo "Proceeding without committing..."
      echo ""
      ;;
    *)
      echo "Cancelled"; sleep 1; exit 0
      ;;
  esac
fi

# Push first — this is the same regardless of base branch choice
echo "Pushing $branch..."
git push -u origin "$branch" 2>&1 || { echo "Push failed"; sleep 2; exit 1; }
echo ""

# Check if PR already exists
existing=$(gh pr view "$branch" --json url -q '.url' 2>/dev/null) || true
if [[ -n "$existing" ]]; then
  echo "PR already exists: $existing"
  echo ""
  printf "Open in browser? [y/N]: "
  read -r open_existing
  if [[ "$open_existing" =~ ^[yY]$ ]]; then
    open "$existing"
  fi
  exit 0
fi

# Find the base branch from pane-map (recorded at worktree creation time).
# Only check the 20 most recent files to avoid scanning hundreds of old entries.
pane_base=""
for mapfile in $(ls -t ~/.claude/pane-map/*.json 2>/dev/null | head -20); do
  [[ -f "$mapfile" ]] || continue
  wt=$(jq -r '.worktree // empty' "$mapfile" 2>/dev/null) || continue
  if [[ "$wt" == "$branch" || "$wt" == "${branch}+" ]]; then
    pane_base=$(jq -r '.base_branch // empty' "$mapfile" 2>/dev/null) || true
    [[ -n "$pane_base" ]] && break
  fi
done

# Get repo default branch (with timeout so GHE doesn't block the popup)
default_branch=$(timeout 3 gh repo view --json defaultBranchRef -q '.defaultBranchRef.name' 2>/dev/null) || true
[[ -z "$default_branch" ]] && default_branch="main"

# Rank candidate base branches by distance (closest ancestor first)
candidates=()
for candidate in dev main master develop staging production; do
  git show-ref --verify --quiet "refs/heads/$candidate" 2>/dev/null || continue
  [[ "$candidate" == "$branch" ]] && continue
  count=$(git rev-list --count "$candidate".."$branch" 2>/dev/null) || continue
  candidates+=("${count} ${candidate}")
done
sorted=$(printf '%s\n' "${candidates[@]}" | sort -n)

# Pick the best guess: pane-map base if set, otherwise closest ancestor
if [[ -n "$pane_base" && "$pane_base" != "$branch" ]]; then
  best_guess="$pane_base"
else
  best_guess=$(echo "$sorted" | head -1 | awk '{print $2}')
  [[ -z "$best_guess" ]] && best_guess="$default_branch"
fi

# Build the picker menu
echo "Select base branch for PR:"
echo ""
idx=1
options=()

# Best guess first (marked as recommended)
ahead_best=$(git rev-list --count "$best_guess".."$branch" 2>/dev/null || echo "?")
echo "  $idx) $best_guess  ($ahead_best commits ahead) ← recommended"
options+=("$best_guess")
idx=$((idx + 1))

# Repo default if different
if [[ "$default_branch" != "$best_guess" ]]; then
  if git show-ref --verify --quiet "refs/heads/$default_branch" 2>/dev/null; then
    ahead_def=$(git rev-list --count "$default_branch".."$branch" 2>/dev/null || echo "?")
    echo "  $idx) $default_branch  ($ahead_def commits ahead) ← repo default"
    options+=("$default_branch")
    idx=$((idx + 1))
  fi
fi

# Other candidates sorted by distance
while IFS= read -r line; do
  [[ -z "$line" ]] && continue
  count=$(echo "$line" | awk '{print $1}')
  cand=$(echo "$line" | awk '{print $2}')
  [[ "$cand" == "$best_guess" || "$cand" == "$default_branch" ]] && continue
  echo "  $idx) $cand  ($count commits ahead)"
  options+=("$cand")
  idx=$((idx + 1))
done <<< "$sorted"

echo ""
printf "Choice [1]: "
read -r base_choice
[[ -z "$base_choice" ]] && base_choice=1

base_idx=$((base_choice - 1))
if [[ $base_idx -ge 0 && $base_idx -lt ${#options[@]} ]]; then
  base_branch="${options[$base_idx]}"
else
  echo "Invalid choice"; sleep 2; exit 1
fi

if [[ "$branch" == "$base_branch" ]]; then
  echo "Already on $base_branch — nothing to PR"
  sleep 2; exit 1
fi

# Generate PR description from diff against base
echo ""
echo "Generating PR description..."
pr_diff=$(git --no-pager diff "$base_branch"..."$branch" --stat && echo "---" && git --no-pager diff "$base_branch"..."$branch" -- . ':(exclude)*.lock' ':(exclude)package-lock.json' | head -500)
pr_commits=$(git --no-pager log --oneline "$base_branch".."$branch" | head -20)

pr_desc=$(printf '%s\n\n--- Commits ---\n%s' "$pr_diff" "$pr_commits" | claude -p \
  "Write a GitHub PR description for these changes on branch '${branch}' merging into '${base_branch}'.
Format:
## Summary
1-3 bullet points describing what changed and why.

## Changes
- List the key changes grouped logically.

Output ONLY the PR description in markdown, nothing else." \
  --model claude-sonnet-4-6 2>/dev/null) || pr_desc=""

if [[ -n "$pr_desc" ]]; then
  echo ""
  echo "--- PR Description ---"
  echo "$pr_desc"
  echo "----------------------"
  echo ""
  # Copy to clipboard — pbcopy (macOS) / clip.exe (WSL) / wl-copy / xclip.
  if command -v pbcopy >/dev/null 2>&1;   then _clip=pbcopy
  elif command -v clip.exe >/dev/null 2>&1; then _clip=clip.exe
  elif command -v wl-copy >/dev/null 2>&1;  then _clip=wl-copy
  elif command -v xclip >/dev/null 2>&1;    then _clip="xclip -selection clipboard"
  else _clip="cat >/dev/null"; fi
  printf '%s' "$pr_desc" | $_clip 2>/dev/null && echo "(Copied to clipboard)"
  echo ""
fi

# Build PR link from git remote
remote_url=$(git remote get-url origin 2>/dev/null) || true
repo_url=""
if [[ "$remote_url" =~ ^([^@]+)@([^:]+):(.+)$ ]]; then
  host="${BASH_REMATCH[2]}"
  path="${BASH_REMATCH[3]%.git}"
  repo_url="https://${host}/${path}"
elif [[ "$remote_url" =~ ^https?:// ]]; then
  repo_url="${remote_url%.git}"
fi

if [[ -n "$repo_url" ]]; then
  pr_link="${repo_url}/compare/${base_branch}...${branch}?expand=1"
  echo "Create PR: $pr_link"
  echo "Base: $base_branch ← $branch"
  echo ""
  printf "Open in browser? [y/N]: "
  read -r open_choice
  if [[ "$open_choice" =~ ^[yY]$ ]]; then
    open "$pr_link"
  fi
else
  echo "Could not determine repo URL from remote: $remote_url"
  sleep 3
fi
